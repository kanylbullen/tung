<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- The end of a rest with the app in the background (timer/RestAlarm.kt), in both apps. -->
        <receiver
            android:name="io.github.kanylbullen.tung.timer.RestTimerReceiver"
            android:exported="false" />
        <!-- "Log set" on the ongoing notification of a workout in progress (ongoing/OngoingWorkoutNotifier.kt). -->
        <receiver
            android:name="io.github.kanylbullen.tung.ongoing.OngoingWorkoutReceiver"
            android:exported="false" />

        <!-- Push (push/): the server's empty "sync now" over FCM, when the build has a Firebase app. -->
        <service
            android:name="io.github.kanylbullen.tung.push.TungFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- ... and over UnifiedPush, from a distributor app such as ntfy. -->
        <receiver
            android:name="io.github.kanylbullen.tung.push.TungUnifiedPushReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_REFUSED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
