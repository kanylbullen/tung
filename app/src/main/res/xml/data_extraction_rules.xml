<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The sync token and the assistant's API key are encrypted with a Keystore key that a backup or transfer cannot carry. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync_token.xml" />
        <exclude domain="sharedpref" path="ai_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync_token.xml" />
        <exclude domain="sharedpref" path="ai_key.xml" />
    </device-transfer>
</data-extraction-rules>
