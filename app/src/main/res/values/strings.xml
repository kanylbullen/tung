    <!-- Settings: Health Connect (ui/settings/HealthConnectSection.kt) -->
    <string name="health_title">Health Connect</string>
    <string name="health_write">Write workouts to Health Connect</string>
    <string name="health_write_hint">Each finished workout is saved there as a strength-training session, so other health apps show it.</string>
    <string name="health_read">Read heart rate and calories</string>
    <string name="health_read_hint">After a workout, its average and maximum heart rate and active calories are read from Health Connect and saved with it.</string>
    <string name="health_unavailable">Health Connect is not available on this phone.</string>
    <string name="health_needs_update">Install or update Health Connect to use it here.</string>
    <string name="health_denied">Health Connect did not give the permission. You can grant it in Health Connect\'s settings and try again.</string>
    <!-- What Tung does with Health Connect data (HealthPermissionsActivity), shown by Health Connect -->
    <string name="health_rationale_title">Tung and Health Connect</string>
    <string name="health_rationale_write">If you turn on “Write workouts to Health Connect” in Settings, Tung saves each workout you finish there as a strength-training session, with a segment for each set of an exercise Health Connect knows. Nothing else is written.</string>
    <string name="health_rationale_read">If you turn on “Read heart rate and calories”, Tung reads your heart rate and active calories for the time of each workout you finish, and saves the average and maximum heart rate and the calories with that workout. Nothing outside your workouts is read.</string>
    <string name="health_rationale_where">These values stay in Tung on this phone. If you sync with a Tung server you chose in Settings, they are stored there with the workout, like the rest of it. Tung has no analytics and sends them nowhere else.</string>
    <string name="health_rationale_off">You can turn either off in Tung\'s Settings and revoke the permissions in Health Connect at any time.</string>

