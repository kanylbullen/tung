# Build context for server/Dockerfile (BuildKit reads <Dockerfile>.dockerignore).
# Everything is excluded except what the server build needs.
*
!gradlew
!gradle/
!build.gradle.kts
!settings.gradle.kts
!gradle.properties
!core/
!server/
!web/
!kotlin-js-store/
!catalog/*.json
!app/src/main/res/font/archivo_variable.ttf
!app/src/main/assets/licenses/archivo-OFL.txt
**/build/
**/.gradle/
**/.kotlin/
