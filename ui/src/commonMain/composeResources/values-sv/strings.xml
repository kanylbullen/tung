<?xml version="1.0" encoding="utf-8"?>
<!--
  The strings of the screens in ui/, as Compose Resources: the same names and
  texts as app/'s res/values-sv/strings.xml had, with every placeholder
  positional (%1$d), the only form Compose Resources fills in, and no quotes
  around a text that keeps its outer spaces (", " in app/ is , here: Compose
  Resources keeps quotes as text, and keeps the spaces). A string still
  used by a screen in app/ is in both files until that screen moves too;
  app's SharedStringsTest keeps the two texts equal.
-->
