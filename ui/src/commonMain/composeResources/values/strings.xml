<?xml version="1.0" encoding="utf-8"?>
<!--
  The strings of the screens in ui/, as Compose Resources. app/ reads the ones
  it needs from here (Res.string.…), so each string lives in one module;
  ResourcesTest checks that, and the Swedish names. Compose Resources fill in
  positional placeholders only (%1$d, never %d), show quotes as text (write
  ", " as , and keep the spaces) and need no escapes (an apostrophe is ').
-->
