# Copy to .env next to docker-compose.yml and fill in.

# Postgres. Pick a long random password: openssl rand -base64 32
POSTGRES_DB=tung
POSTGRES_USER=tung
POSTGRES_PASSWORD=

# The address people and apps reach the server on, without a trailing slash.
# Named as the server in /openapi.yaml.
TUNG_PUBLIC_URL=https://tung.example.org

# Behind a reverse proxy (Caddy, Traefik, nginx) that sets X-Forwarded-For:
# true, so rate limiting and logs see the client, not the proxy. Leave false
# when the server is reachable directly, or clients can spoof their address.
TUNG_TRUST_PROXY=false

# Where the published port listens. 127.0.0.1 keeps it local for a reverse
# proxy on the same host; 0.0.0.0 exposes it on every interface.
TUNG_BIND=127.0.0.1
TUNG_PORT=8080
